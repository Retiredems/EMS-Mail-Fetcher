/* ═══════════════════════════════════════════════════════════════════════
   EMS Mail Fetcher — Light Theme
   ═══════════════════════════════════════════════════════════════════════ */

QMainWindow, QDialog {
    background-color: #f6f8fa;
    color: #1f2328;
}
QWidget {
    background-color: #f6f8fa;
    color: #1f2328;
    font-family: "SF Pro Text", "Helvetica Neue", "Segoe UI", Arial, sans-serif;
    font-size: 13px;
}

/* ── Sidebar (stays dark in light mode — same as EMS Mailer) ── */
QFrame#sidebar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #0a1628, stop:0.5 #0d1f3a, stop:1 #071020);
    border-right: 1px solid rgba(13, 239, 168, 0.22);
}
QWidget#main_central, QWidget#main_content { background: transparent; }

QLabel#sidebar_bolt { font-size: 30px; background: transparent; color: #0defa8; }
QLabel#sidebar_wordmark {
    font-size: 32px; font-weight: 900; letter-spacing: 7px;
    color: #0defa8; background: transparent;
}
QFrame#sidebar_rule {
    border: none; border-top: 1px solid rgba(13, 239, 168, 0.22);
    max-height: 1px; margin: 0 14px; background: transparent;
}
QLabel#sidebar_product {
    font-size: 11px; font-weight: 700; letter-spacing: 2px;
    color: #7ecfb3; background: transparent;
}
QLabel#sidebar_tagline {
    font-size: 11px; font-weight: 500; color: #5bbf9a;
    letter-spacing: 0.3px; background: transparent;
}
QPushButton#sidebar_buy_btn {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #22ffc8, stop:0.45 #0defa8, stop:1 #09c280);
    border: none;
    border-bottom: 3px solid #057a4e;
    border-radius: 9px;
    color: #021910;
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 0.6px;
    padding: 9px 6px 6px 6px;
    margin: 0 10px;
}
QPushButton#sidebar_buy_btn:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #2effd5, stop:0.45 #18ffb8, stop:1 #0defa8);
    border-bottom-color: #0a9a66;
}
QPushButton#sidebar_buy_btn:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #0defa8, stop:1 #09c280);
    border-bottom-width: 1px;
    padding-top: 11px;
    padding-bottom: 4px;
}
QLabel#sidebar_lic_good {
    font-size: 9px; font-weight: 700; color: #0defa8;
    background: rgba(13, 239, 168, 0.12); border: 1px solid rgba(13, 239, 168, 0.35);
    border-radius: 10px; padding: 3px 8px; margin: 0 14px;
}
QLabel#sidebar_lic_warn {
    font-size: 9px; font-weight: 700; color: #ff6b78;
    background: rgba(255, 107, 120, 0.12); border: 1px solid rgba(255, 107, 120, 0.35);
    border-radius: 10px; padding: 3px 8px; margin: 0 14px;
}
QLabel#sidebar_footer { font-size: 11px; background: transparent; color: #4d9c83; }

/* ── Toolbar row (light) ── */
QWidget#toolbar_row {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #ffffff, stop:1 #f0f2f5);
    border-bottom: 1px solid #d0d7de;
}
QPushButton#tb_btn {
    background: rgba(10, 138, 96, 0.08); color: #0a7a55;
    border: 1px solid rgba(10, 138, 96, 0.30); border-radius: 5px;
    padding: 4px 11px; font-weight: 700; font-size: 12px;
}
QPushButton#tb_btn:hover {
    background: rgba(10, 138, 96, 0.16); border-color: rgba(10, 138, 96, 0.55);
}
QPushButton#tb_btn_primary {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #0defa8, stop:1 #0ab87e);
    color: #04100c; border: none; border-radius: 5px;
    padding: 4px 14px; font-weight: 800; font-size: 12px;
}
QPushButton#tb_btn_primary:hover { background: #0ab87e; }
QPushButton#tb_btn_primary:disabled { background: #c8e8df; color: #8aaaa0; }
QPushButton#tb_btn_danger {
    background: rgba(207, 34, 46, 0.07); color: #cf222e;
    border: 1px solid rgba(207, 34, 46, 0.28); border-radius: 5px;
    padding: 4px 11px; font-weight: 700; font-size: 12px;
}
QPushButton#tb_btn_danger:hover {
    background: rgba(207, 34, 46, 0.14); border-color: rgba(207, 34, 46, 0.55);
}
QPushButton#tb_btn_sec {
    background: #ffffff; color: #424a53;
    border: 1px solid #d0d7de; border-radius: 5px;
    padding: 4px 11px; font-weight: 600; font-size: 12px;
}
QPushButton#tb_btn_sec:hover { background: #f3f4f6; border-color: #adb5bd; color: #1f2328; }
QFrame#tb_sep { color: #d0d7de; max-width: 1px; margin: 9px 3px; background: #d0d7de; }
QLabel#tb_label { color: #636c76; font-size: 11px; background: transparent; }
QLineEdit#tb_threads {
    background: rgba(10, 138, 96, 0.06); color: #0a7a55;
    border: 1px solid rgba(10, 138, 96, 0.30); border-radius: 5px;
    padding: 3px 5px; font-weight: 700; font-size: 12px;
}
QCheckBox#tb_check {
    color: #1f2328; font-size: 12px; font-weight: 500;
    spacing: 6px; background: transparent;
}
QCheckBox#tb_check::indicator {
    width: 15px; height: 15px; border: 2px solid #adb5bd;
    border-radius: 4px; background: #ffffff;
}
QCheckBox#tb_check::indicator:checked {
    background: #0defa8; border-color: #0ab87e;
    image: url(CHECKMARK_PATH);
}

/* ── Update bar (light) ── */
QWidget#update_bar {
    background: rgba(10, 138, 96, 0.07);
    border-bottom: 1px solid rgba(10, 138, 96, 0.25);
}
QLabel#update_label { color: #0a7a55; font-size: 12px; font-weight: 600; background: transparent; }
QPushButton#update_now_btn {
    background: rgba(10, 138, 96, 0.14); border: 1px solid rgba(10, 138, 96, 0.38);
    border-radius: 4px; color: #0a7a55; font-size: 11px; font-weight: 700; padding: 3px 10px;
}
QPushButton#update_now_btn:hover { background: rgba(10, 138, 96, 0.24); }
QPushButton#update_dismiss_btn {
    background: transparent; border: 1px solid #d0d7de; border-radius: 4px;
    color: #636c76; font-size: 11px; font-weight: 700; padding: 3px 10px;
}
QPushButton#update_dismiss_btn:hover { color: #1f2328; }

/* ── Table ── */
QTableView, QTableWidget {
    background-color: #ffffff; alternate-background-color: #f6f8fa;
    gridline-color: #d0d7de; selection-background-color: rgba(10,138,96,0.12);
    selection-color: #1f2328; border: none; border-top: 1px solid #d0d7de; color: #1f2328;
}
QHeaderView::section {
    background-color: #f6f8fa; color: #424a53; padding: 6px 8px;
    border: none; border-right: 1px solid #d0d7de; border-bottom: 1px solid #d0d7de;
    font-weight: 700; font-size: 11px; letter-spacing: 0.5px;
}
QHeaderView::section:hover { background-color: #eaeef2; }

/* ── Status bar ── */
QStatusBar { background: #f0f2f5; color: #636c76; border-top: 1px solid #d0d7de; font-size: 12px; }
QStatusBar QLabel { color: #424a53; font-size: 12px; background: transparent; }

/* ── Input fields ── */
QLineEdit, QComboBox, QSpinBox {
    background: #ffffff; color: #1f2328; border: 1px solid #d0d7de;
    border-radius: 5px; padding: 5px 9px; selection-background-color: rgba(10,138,96,0.2);
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus { border-color: rgba(10,138,96,0.55); }
QComboBox::drop-down { border: none; width: 20px; }
QComboBox QAbstractItemView {
    background: #ffffff; selection-background-color: rgba(10,138,96,0.12);
    border: 1px solid #d0d7de; color: #1f2328;
}

/* ── Buttons (generic) ── */
QPushButton {
    background: #ffffff; color: #1f2328; border: 1px solid #d0d7de;
    border-radius: 5px; padding: 6px 16px; font-weight: 700;
}
QPushButton:hover { background: #f3f4f6; border-color: #adb5bd; }
QPushButton:pressed { background: #eaeef2; }
QPushButton:disabled { background: #f6f8fa; color: #adb5bd; }

/* ── CheckBox / Radio ── */
QCheckBox, QRadioButton { spacing: 6px; color: #1f2328; background: transparent; }
QCheckBox::indicator, QRadioButton::indicator {
    width: 15px; height: 15px; border: 2px solid #adb5bd; border-radius: 4px; background: #ffffff;
}
QCheckBox::indicator:checked { background: #0defa8; border-color: #0ab87e; image: url(CHECKMARK_PATH); }
QRadioButton::indicator { border-radius: 8px; }
QRadioButton::indicator:checked { background: #0defa8; border-color: #0ab87e; }

/* ── GroupBox ── */
QGroupBox {
    border: 1px solid #d0d7de; border-radius: 6px; margin-top: 12px;
    padding-top: 8px; font-weight: 600; color: #424a53;
}
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 6px; color: #0a7a55; }

/* ── Scroll bars ── */
QScrollBar:vertical { background: #f6f8fa; width: 8px; border-radius: 4px; margin: 0; }
QScrollBar::handle:vertical { background: #d0d7de; border-radius: 4px; min-height: 24px; }
QScrollBar::handle:vertical:hover { background: #adb5bd; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { background: #f6f8fa; height: 8px; border-radius: 4px; }
QScrollBar::handle:horizontal { background: #d0d7de; border-radius: 4px; min-width: 24px; }
QScrollBar::handle:horizontal:hover { background: #adb5bd; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

/* ── Menu ── */
QMenuBar { background: #f6f8fa; color: #424a53; border-bottom: 1px solid #d0d7de; }
QMenuBar::item:selected { background: #eaeef2; }
QMenu { background: #ffffff; border: 1px solid #d0d7de; color: #1f2328; }
QMenu::item:selected { background: rgba(10, 138, 96, 0.10); color: #0a7a55; }
QMenu::separator { height: 1px; background: #d0d7de; margin: 3px 0; }

/* ── Misc ── */
QFrame[frameShape="4"], QFrame[frameShape="5"] { color: #d0d7de; }
QProgressBar {
    border: 1px solid #d0d7de; border-radius: 4px; background: #f6f8fa; height: 8px; color: #0a7a55;
}
QProgressBar::chunk { background: #0defa8; border-radius: 4px; }
QTextEdit, QPlainTextEdit {
    background: #ffffff; color: #1f2328; border: 1px solid #d0d7de;
    border-radius: 5px; padding: 8px; font-size: 12px;
}
